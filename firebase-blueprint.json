{
  "entities": {
    "Room": {
      "title": "Room",
      "description": "Online co-op multiplayer room metadata shared across devices.",
      "type": "object",
      "properties": {
        "roomId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 20,
          "pattern": "^[a-z0-9_-]+$"
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["roomId", "createdBy", "createdAt", "updatedAt"]
    },
    "RoomPlayer": {
      "title": "RoomPlayer",
      "description": "Live explorer position, animation, and map state in an online room.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 4,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "roomId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 20,
          "pattern": "^[a-z0-9_-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 18
        },
        "colorIdx": {
          "type": "number"
        },
        "mapId": {
          "type": "string",
          "enum": [
            "lost_valley",
            "alpine_glacier",
            "emerald_archipelago",
            "saffron_canyon",
            "misty_wetlands",
            "crimson_caldera",
            "twin_fjords",
            "highland_meadows"
          ]
        },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" },
        "yaw": { "type": "number" },
        "speed": { "type": "number" },
        "crouch": { "type": "boolean" },
        "sprint": { "type": "boolean" },
        "swim": { "type": "boolean" },
        "flashlight": { "type": "boolean" },
        "attackCombo": { "type": "number" },
        "attackTimer": { "type": "number" },
        "heavy": { "type": "boolean" },
        "dodge": { "type": "boolean" },
        "guard": { "type": "boolean" },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerUid",
        "roomId",
        "name",
        "colorIdx",
        "mapId",
        "x",
        "y",
        "z",
        "yaw",
        "speed",
        "crouch",
        "sprint",
        "swim",
        "flashlight",
        "attackCombo",
        "attackTimer",
        "heavy",
        "dodge",
        "guard",
        "updatedAt"
      ]
    },
    "RoomMessage": {
      "title": "RoomMessage",
      "description": "Short chat message inside a multiplayer co-op room.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 4,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "playerId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "roomId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 20,
          "pattern": "^[a-z0-9_-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 18
        },
        "colorIdx": {
          "type": "number"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerUid",
        "playerId",
        "roomId",
        "name",
        "colorIdx",
        "text",
        "createdAt"
      ]
    },
    "RoomWorld": {
      "title": "RoomWorld",
      "description": "Shared room environment (weather, time-of-day, campfire) and host-synced enemy states per map.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "lost_valley",
            "alpine_glacier",
            "emerald_archipelago",
            "saffron_canyon",
            "misty_wetlands",
            "crimson_caldera",
            "twin_fjords",
            "highland_meadows"
          ]
        },
        "roomId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 20,
          "pattern": "^[a-z0-9_-]+$"
        },
        "mapId": {
          "type": "string",
          "enum": [
            "lost_valley",
            "alpine_glacier",
            "emerald_archipelago",
            "saffron_canyon",
            "misty_wetlands",
            "crimson_caldera",
            "twin_fjords",
            "highland_meadows"
          ]
        },
        "weatherMode": {
          "type": "string",
          "enum": ["DYNAMIC", "CLEAR", "FOGGY", "RAIN", "STORM", "SNOW"]
        },
        "timeAnchorHours": { "type": "number" },
        "timeAnchorMs": { "type": "number" },
        "timePaused": { "type": "boolean" },
        "campfireLit": { "type": "boolean" },
        "hostSessionId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "enemies": {
          "type": "array"
        },
        "updatedByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "roomId",
        "mapId",
        "weatherMode",
        "timeAnchorHours",
        "timeAnchorMs",
        "timePaused",
        "campfireLit",
        "hostSessionId",
        "enemies",
        "updatedByUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "RoomEnemyHit": {
      "title": "RoomEnemyHit",
      "description": "Co-op melee hit event sent by a player to the authoritative host for shared enemy damage.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 4,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "roomId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 20,
          "pattern": "^[a-z0-9_-]+$"
        },
        "mapId": {
          "type": "string",
          "enum": [
            "lost_valley",
            "alpine_glacier",
            "emerald_archipelago",
            "saffron_canyon",
            "misty_wetlands",
            "crimson_caldera",
            "twin_fjords",
            "highland_meadows"
          ]
        },
        "enemyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "attackerId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "damage": { "type": "number" },
        "dirX": { "type": "number" },
        "dirZ": { "type": "number" },
        "heavy": { "type": "boolean" },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerUid",
        "roomId",
        "mapId",
        "enemyId",
        "attackerId",
        "damage",
        "dirX",
        "dirZ",
        "heavy",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/rooms/{roomId}": {
      "schema": { "$ref": "#/entities/Room" },
      "description": "Shared multiplayer room metadata document."
    },
    "/rooms/{roomId}/players/{playerId}": {
      "schema": { "$ref": "#/entities/RoomPlayer" },
      "description": "Real-time player avatar state for an active session in the room."
    },
    "/rooms/{roomId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/RoomMessage" },
      "description": "Co-op room chat messages."
    },
    "/rooms/{roomId}/worlds/{mapId}": {
      "schema": { "$ref": "#/entities/RoomWorld" },
      "description": "Shared weather, time, campfire, and enemy states per map inside a room."
    },
    "/rooms/{roomId}/hits/{hitId}": {
      "schema": { "$ref": "#/entities/RoomEnemyHit" },
      "description": "Co-op melee hit events targeting shared enemies in a room."
    }
  }
}
